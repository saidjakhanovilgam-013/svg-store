# ===================================
# SERVER VA ATROF-MUHIT SOZLAMALARI
# ===================================
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# ===================================
# POSTGRESQL MA'LUMOTLAR BAZASI
# ===================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=svg_store
DB_USER=postgres
DB_PASSWORD=1234

# DATABASE_URL (Agar Neon, Render yoki Supabase kabi bulutli bazadan foydalansangiz):
# DATABASE_URL=postgres://user:password@localhost:5432/svg_store

# ===================================
# EXPRESS SESSION VA COOKIE XAVFSIZLIGI
# ===================================
SESSION_SECRET=juda_uzun_va_murakkab_xavfsizlik_kaliti_123456789!@#

# ===================================
# GOOGLE OAUTH2 INTEGRATSIYASI
# (Google Cloud Console'dan olinadi)
# ===================================
GOOGLE_CLIENT_ID=317953914802-d4k3bt4o1kl5022c32p0teliur6iou92.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# ===================================
# TO'LOV TIZIMLARI INTEGRATSIYASI (v1)
# ===================================
# Payme
PAYME_MERCHANT_ID=payme_kassa_id
PAYME_SECRET_KEY=payme_test_va_live_key

# Click
CLICK_SERVICE_ID=click_xizmat_id
CLICK_MERCHANT_ID=click_merchant_id
CLICK_SECRET_KEY=click_secret_key

# Stripe (Xalqaro to'lovlar uchun)
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ===================================
# FAYLLARNI SAQLASH (S3 / Local)
# ===================================
# Local xotira uchun: 'local', Bulut uchun: 's3'
STORAGE_TYPE=local

# AWS S3 (Agar kelajakda bulutga o'tsangiz)
AWS_ACCESS_KEY_ID=aws_access_key
AWS_SECRET_ACCESS_KEY=aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=svg-store-files
