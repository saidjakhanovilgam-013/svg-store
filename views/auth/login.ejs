<%- include('../partials/header') %>

<div class="min-h-[80vh] flex items-center justify-center px-6 py-12 relative">
  <!-- Neon Glow Orqa Fon -->
  <div class="glow-bg w-80 h-80 bg-indigo-600/30 top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2"></div>

  <div class="w-full max-w-md glass-box rounded-3xl p-8 border border-white/10 relative z-10 shadow-2xl">
    
    <div class="text-center mb-8">
      <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-indigo-500 to-purple-500 flex items-center justify-center mx-auto mb-3 shadow-lg shadow-indigo-500/30">
        <i class="fa-solid fa-right-to-bracket text-white text-xl"></i>
      </div>
      <h1 class="text-2xl font-black text-white">Tizimga kirish</h1>
      <p class="text-sm text-slate-400 mt-1">Hisobingizga kirib, loyihalarni davom ettiring</p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="mb-5 p-3 rounded-xl bg-red-500/10 border border-red-500/30 text-red-400 text-xs font-semibold text-center">
        <%= error %>
      </div>
    <% } %>

    <form action="/auth/login" method="POST" class="space-y-4">
      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1.5">Email manzil</label>
        <div class="relative">
          <i class="fa-solid fa-envelope absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 text-sm"></i>
          <input type="email" name="email" required placeholder="example@domain.com" class="w-full bg-slate-900/90 border border-slate-700/80 rounded-xl pl-10 pr-4 py-2.5 text-slate-100 placeholder-slate-500 focus:outline-none focus:border-indigo-500 text-sm">
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1.5">Parol</label>
        <div class="relative">
          <i class="fa-solid fa-lock absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 text-sm"></i>
          <input type="password" name="password" required placeholder="••••••••" class="w-full bg-slate-900/90 border border-slate-700/80 rounded-xl pl-10 pr-4 py-2.5 text-slate-100 placeholder-slate-500 focus:outline-none focus:border-indigo-500 text-sm">
        </div>
      </div>

      <button type="submit" class="w-full py-3 bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-500 hover:to-purple-500 text-white font-semibold rounded-xl transition-all shadow-lg shadow-indigo-600/30 mt-2">
        Kirish
      </button>
    </form>

    <div class="relative my-6 text-center">
      <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-white/10"></div></div>
      <span class="relative px-4 bg-[#0b0f19] text-xs text-slate-500 font-semibold uppercase">yoki</span>
    </div>

    <!-- Google Login Button -->
    <a href="/auth/google" class="w-full py-3 px-4 bg-white/5 hover:bg-white/10 border border-white/10 rounded-xl text-slate-200 text-sm font-semibold flex items-center justify-center gap-3 transition-all hover:scale-[1.02]">
      <svg class="w-5 h-5" viewBox="0 0 24 24">
        <path fill="#EA4335" d="M12 5c1.6 0 3 .6 4.1 1.6l3.1-3.1C17.3 1.7 14.8 1 12 1 7.5 1 3.7 3.6 1.9 7.3l3.7 2.9C6.5 7.3 9 5 12 5z"/>
        <path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.5c-.3 1.5-1.1 2.8-2.4 3.7l3.7 2.9c2.2-2 3.7-5 3.7-8.8z"/>
        <path fill="#FBBC05" d="M5.6 14.8c-.2-.7-.4-1.5-.4-2.3s.2-1.6.4-2.3L1.9 7.3C.7 9.7 0 12 0 14.8s.7 5.1 1.9 7.5l3.7-2.9 shadow-none"/>
        <path fill="#34A853" d="M12 23c3.2 0 6-1.1 8-3l-3.7-2.9c-1.1.7-2.5 1.2-4.3 1.2-3 0-5.5-2.3-6.4-5.2L1.9 16C3.7 19.7 7.5 23 12 23z"/>
      </svg>
      Google orqali kirish
    </a>

    <p class="text-center text-xs text-slate-400 mt-6">
      Hali hisobingiz yo'qmi? <a href="/auth/register" class="text-indigo-400 font-semibold hover:underline">Ro'yxatdan o'ting</a>
    </p>

  </div>
</div>

<%- include('../partials/footer') %>
