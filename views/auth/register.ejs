<%- include('../partials/header') %>

<div class="min-h-[80vh] flex items-center justify-center px-6 py-12 relative">
  <div class="glow-bg w-80 h-80 bg-purple-600/30 top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2"></div>

  <div class="w-full max-w-md glass-box rounded-3xl p-8 border border-white/10 relative z-10 shadow-2xl">
    <div class="text-center mb-8">
      <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-purple-500 to-indigo-500 flex items-center justify-center mx-auto mb-3 shadow-lg shadow-purple-500/30">
        <i class="fa-solid fa-user-plus text-white text-xl"></i>
      </div>
      <h1 class="text-2xl font-black text-white">Ro'yxatdan o'tish</h1>
      <p class="text-sm text-slate-400 mt-1">SVG Store'da bepul hisob yarating</p>
    </div>

    <% if (typeof error_msg !== 'undefined' && error_msg) { %>
      <div role="alert" class="mb-5 p-3 rounded-xl bg-red-500/10 border border-red-500/30 text-red-300 text-xs font-semibold text-center">
        <i class="fa-solid fa-circle-exclamation mr-1"></i> <%= error_msg %>
      </div>
    <% } %>

    <form action="/auth/register" method="POST" class="space-y-4">
      <div>
        <label for="register-name" class="block text-xs font-semibold text-slate-300 mb-1.5">Ism va familiya</label>
        <div class="relative">
          <i class="fa-solid fa-user absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 text-sm"></i>
          <input id="register-name" type="text" name="name" required autocomplete="name" placeholder="Masalan: Ali Valiyev" class="w-full bg-slate-900/90 border border-slate-700/80 rounded-xl pl-10 pr-4 py-3 text-slate-100 placeholder-slate-500 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500/50 text-sm transition-colors">
        </div>
      </div>

      <div>
        <label for="register-email" class="block text-xs font-semibold text-slate-300 mb-1.5">Email manzil</label>
        <div class="relative">
          <i class="fa-solid fa-envelope absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 text-sm"></i>
          <input id="register-email" type="email" name="email" required autocomplete="email" placeholder="example@mail.com" class="w-full bg-slate-900/90 border border-slate-700/80 rounded-xl pl-10 pr-4 py-3 text-slate-100 placeholder-slate-500 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500/50 text-sm transition-colors">
        </div>
      </div>

      <div>
        <label for="register-password" class="block text-xs font-semibold text-slate-300 mb-1.5">Parol</label>
        <div class="relative">
          <i class="fa-solid fa-lock absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 text-sm"></i>
          <input id="register-password" type="password" name="password" required minlength="6" autocomplete="new-password" placeholder="Kamida 6 ta belgi" class="w-full bg-slate-900/90 border border-slate-700/80 rounded-xl pl-10 pr-4 py-3 text-slate-100 placeholder-slate-500 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500/50 text-sm transition-colors">
        </div>
      </div>

      <button type="submit" class="w-full py-3 bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-500 hover:to-purple-500 text-white font-semibold rounded-xl transition-all shadow-lg shadow-indigo-600/30 mt-2">
        <i class="fa-solid fa-user-plus mr-2"></i> Ro'yxatdan o'tish
      </button>
    </form>

    <div class="relative my-6 text-center">
      <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-white/10"></div></div>
      <span class="relative px-4 bg-[#0b0f19] text-xs text-slate-500 font-semibold uppercase">yoki</span>
    </div>

    <a href="/auth/google" class="w-full py-3 px-4 bg-white/5 hover:bg-white/10 border border-white/10 rounded-xl text-slate-200 text-sm font-semibold flex items-center justify-center gap-3 transition-all">
      <i class="fa-brands fa-google text-base"></i>
      Google orqali ro'yxatdan o'tish
    </a>

    <p class="text-center text-xs text-slate-400 mt-6">
      Allaqachon hisobingiz bormi? <a href="/auth/login" class="text-indigo-400 font-semibold hover:underline">Tizimga kiring</a>
    </p>
  </div>
</div>

<%- include('../partials/footer') %>
