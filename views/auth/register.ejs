<%- include('../partials/header') %>

<div style="max-width: 450px; margin: 3rem auto; background: white; padding: 2rem; border-radius: 8px; border: 1px solid #ddd;">
    <h2 style="text-align: center; margin-top: 0;">Ro'yxatdan o'tish</h2>
    <p style="text-align: center; color: #6b7280; font-size: 0.9rem; margin-bottom: 1.5rem;">
        SVG platformamizga xush kelibsiz! Bepul hisob yarating.
    </p>

    <form action="/auth/register" method="POST">
        <div style="margin-bottom: 1rem;">
            <label style="font-weight: 500; font-size: 0.9rem;">Ism va Familiya:</label><br>
            <input type="text" name="name" required placeholder="Masalan: Ali Valiyev" style="width: 100%; padding: 0.6rem; margin-top: 0.25rem; border: 1px solid #ccc; border-radius: 6px; box-sizing: border-box;">
        </div>

        <div style="margin-bottom: 1rem;">
            <label style="font-weight: 500; font-size: 0.9rem;">Email pochta:</label><br>
            <input type="email" name="email" required placeholder="example@mail.com" style="width: 100%; padding: 0.6rem; margin-top: 0.25rem; border: 1px solid #ccc; border-radius: 6px; box-sizing: border-box;">
        </div>

        <div style="margin-bottom: 1.5rem;">
            <label style="font-weight: 500; font-size: 0.9rem;">Parol yaratish:</label><br>
            <input type="password" name="password" required minlength="6" placeholder="Kamida 6 ta belgi" style="width: 100%; padding: 0.6rem; margin-top: 0.25rem; border: 1px solid #ccc; border-radius: 6px; box-sizing: border-box;">
        </div>

        <button type="submit" class="btn btn-primary" style="width: 100%; padding: 0.75rem;">Ro'yxatdan o'tish</button>
    </form>

    <div style="margin-top: 1.5rem; text-align: center;">
        <p style="color: #6b7280; font-size: 0.85rem; margin-bottom: 1rem;">yoki tezkor kirish:</p>
        <a href="/auth/google" class="btn" style="background: #db4437; color: white; width: 100%; box-sizing: border-radius: 6px; display: inline-block; text-decoration: none;">
            Google orqali ro'yxatdan o'tish
        </a>
    </div>

    <hr style="border: 0; border-top: 1px solid #eee; margin: 1.5rem 0;">

    <p style="text-align: center; font-size: 0.9rem; margin: 0; color: #4b5563;">
        Allaqachon hisobingiz bormi? <a href="/auth/login" style="color: #4f46e5; text-decoration: none; font-weight: 600;">Tizimga kirish</a>
    </p>
</div>

<%- include('../partials/footer') %>