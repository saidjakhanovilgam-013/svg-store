<%- include('../partials/header') %>

<div class="max-w-5xl mx-auto px-6 py-10">

  <!-- Back Link -->
  <a href="<%= isDesigner ? '/custom-orders/designer-orders' : '/custom-orders/my-orders' %>" class="inline-flex items-center gap-2 text-sm text-slate-400 hover:text-indigo-400 font-medium mb-6 transition-colors">
    <i class="fa-solid fa-arrow-left"></i> Buyurtmalar ro'yxatiga qaytish
  </a>

  <!-- Top Status Banner -->
  <div class="glass-box rounded-3xl p-6 md:p-8 border border-white/10 bg-[#0f172a]/90 backdrop-blur-md mb-8">
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6 pb-6 border-b border-white/10">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <span class="text-xs font-bold text-slate-400">Buyurtma #<%= order.id %></span>
          <span class="text-xs font-semibold text-slate-500">• <%= new Date(order.created_at).toLocaleString('uz-UZ') %></span>
        </div>
        <h1 class="text-2xl md:text-3xl font-extrabold text-white"><%= order.title %></h1>
      </div>

      <!-- Status Badge -->
      <div>
        <% if (order.status === 'pending') { %>
          <span class="px-4 py-2 rounded-2xl text-xs font-bold bg-amber-500/10 text-amber-300 border border-amber-500/30 inline-flex items-center gap-2">
            <i class="fa-solid fa-clock animate-pulse"></i> Ko'rib chiqilmoqda
          </span>
        <% } else if (order.status === 'accepted' && !order.is_paid) { %>
          <span class="px-4 py-2 rounded-2xl text-xs font-bold bg-indigo-500/10 text-indigo-300 border border-indigo-500/30 inline-flex items-center gap-2">
            <i class="fa-solid fa-credit-card"></i> Qabul qilindi (To'lov kutilmoqda)
          </span>
        <% } else if (order.status === 'in_progress') { %>
          <span class="px-4 py-2 rounded-2xl text-xs font-bold bg-purple-500/10 text-purple-300 border border-purple-500/30 inline-flex items-center gap-2 animate-pulse">
            <i class="fa-solid fa-gear"></i> Ish jarayonida
          </span>
        <% } else if (order.status === 'submitted') { %>
          <span class="px-4 py-2 rounded-2xl text-xs font-bold bg-teal-500/10 text-teal-300 border border-teal-500/30 inline-flex items-center gap-2">
            <i class="fa-solid fa-gift"></i> Ish topshirildi (Tekshirish kutilmoqda)
          </span>
        <% } else if (order.status === 'completed') { %>
          <span class="px-4 py-2 rounded-2xl text-xs font-bold bg-emerald-500/10 text-emerald-300 border border-emerald-500/30 inline-flex items-center gap-2">
            <i class="fa-solid fa-circle-check"></i> Muvaffaqiyatli yakunlandi
          </span>
        <% } else if (order.status === 'rejected') { %>
          <span class="px-4 py-2 rounded-2xl text-xs font-bold bg-rose-500/10 text-rose-300 border border-rose-500/30 inline-flex items-center gap-2">
            <i class="fa-solid fa-xmark"></i> Rad etildi
          </span>
        <% } %>
      </div>
    </div>

    <!-- Stepper / Jarayon xaritasi -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-6 text-center text-xs">
      <div class="space-y-1">
        <div class="w-8 h-8 rounded-full mx-auto flex items-center justify-center font-bold bg-emerald-600 text-white shadow-lg shadow-emerald-500/30">
          <i class="fa-solid fa-check"></i>
        </div>
        <p class="font-bold text-slate-200">1. Taklif berildi</p>
      </div>

      <div class="space-y-1">
        <div class="w-8 h-8 rounded-full mx-auto flex items-center justify-center font-bold <%= order.status !== 'pending' && order.status !== 'rejected' ? 'bg-emerald-600 text-white' : 'bg-slate-800 text-slate-500' %>">
          <%= order.status !== 'pending' && order.status !== 'rejected' ? '✓' : '2' %>
        </div>
        <p class="font-bold <%= order.status !== 'pending' && order.status !== 'rejected' ? 'text-slate-200' : 'text-slate-500' %>">2. Qabul qilindi</p>
      </div>

      <div class="space-y-1">
        <div class="w-8 h-8 rounded-full mx-auto flex items-center justify-center font-bold <%= order.is_paid ? 'bg-emerald-600 text-white' : 'bg-slate-800 text-slate-500' %>">
          <%= order.is_paid ? '✓' : '3' %>
        </div>
        <p class="font-bold <%= order.is_paid ? 'text-slate-200' : 'text-slate-500' %>">3. To'lov (sinov)</p>
      </div>

      <div class="space-y-1">
        <div class="w-8 h-8 rounded-full mx-auto flex items-center justify-center font-bold <%= order.status === 'completed' ? 'bg-emerald-600 text-white' : 'bg-slate-800 text-slate-500' %>">
          <%= order.status === 'completed' ? '✓' : '4' %>
        </div>
        <p class="font-bold <%= order.status === 'completed' ? 'text-slate-200' : 'text-slate-500' %>">4. Yakunlandi</p>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

    <!-- Left 2 Cols: Order Details and Deliverables -->
    <div class="lg:col-span-2 space-y-6">

      <!-- Action Box for Designer (If Pending) -->
      <% if (isDesigner && order.status === 'pending') { %>
        <div class="glass-box rounded-3xl p-6 border border-amber-500/30 bg-amber-500/5 space-y-4">
          <h3 class="text-base font-bold text-amber-300 flex items-center gap-2">
            <i class="fa-solid fa-bell"></i> Yangi taklif qarori
          </h3>
          <p class="text-xs text-slate-300">Ushbu buyurtmani qabul qilasizmi? Qabul qilganingizdan so'ng mijoz to'lov qiladi va siz ishni boshlashingiz mumkin bo'ladi.</p>
          <div class="flex items-center gap-3 pt-2">
            <form action="/custom-orders/<%= order.id %>/accept" method="POST">
              <button type="submit" class="px-5 py-2.5 bg-emerald-600 hover:bg-emerald-500 text-white font-bold rounded-xl text-xs transition-all shadow-lg shadow-emerald-600/30 flex items-center gap-1.5">
                <i class="fa-solid fa-check"></i> Qabul qilish
              </button>
            </form>
            <form action="/custom-orders/<%= order.id %>/reject" method="POST">
              <button type="submit" class="px-5 py-2.5 bg-rose-600/80 hover:bg-rose-500 text-white font-bold rounded-xl text-xs transition-all flex items-center gap-1.5">
                <i class="fa-solid fa-xmark"></i> Rad etish
              </button>
            </form>
          </div>
        </div>
      <% } %>

      <!-- Action Box for Client (If Accepted, needs payment) -->
      <% if (isClient && order.status === 'accepted' && !order.is_paid) { %>
        <div class="glass-box rounded-3xl p-6 border border-indigo-500/40 bg-indigo-500/10 space-y-4">
          <h3 class="text-base font-bold text-indigo-300 flex items-center gap-2">
            <i class="fa-solid fa-shield-halved text-emerald-400"></i> Dizayner qabul qildi! Sinov to'lovini tasdiqlang
          </h3>
          <p class="text-xs text-slate-300">
            Bu sinov amali real pul yechmaydi va eskrou himoyasini ta'minlamaydi. Tasdiqlangandan so'ng buyurtma ish jarayoniga o'tadi.
          </p>
          <form action="/custom-orders/<%= order.id %>/pay" method="POST" class="pt-2">
            <button type="submit" class="w-full sm:w-auto px-6 py-3.5 bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-extrabold rounded-2xl text-sm transition-all shadow-xl shadow-emerald-600/30 flex items-center justify-center gap-2">
              <i class="fa-solid fa-lock"></i> Sinov to'lovini tasdiqlash (<%= Number(order.budget).toLocaleString('uz-UZ') %> UZS)
            </button>
          </form>
        </div>
      <% } %>

      <!-- Action Box for Designer (Work Submission) -->
      <% if (isDesigner && order.status === 'in_progress') { %>
        <div class="glass-box rounded-3xl p-6 border border-purple-500/30 bg-purple-500/5 space-y-4">
          <h3 class="text-base font-bold text-purple-300 flex items-center gap-2">
            <i class="fa-solid fa-cloud-arrow-up"></i> Tayyor ishni topshirish
          </h3>
          <p class="text-xs text-slate-300">Figma havolasini yozing yoki tayyor faylni (.zip, .pptx, .pdf, .svg) yuklang:</p>

          <form action="/custom-orders/<%= order.id %>/submit" method="POST" enctype="multipart/form-data" class="space-y-4">
            <div>
              <label class="block text-xs font-semibold text-slate-300 mb-1">Figma loyiha havolasi (ixtiyoriy):</label>
              <input type="url" name="figma_url" placeholder="https://www.figma.com/file/..." class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-2.5 text-xs text-slate-100 focus:outline-none focus:border-purple-500">
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-300 mb-1">Yoki tayyor faylni yuklash (ZIP, PPTX, PDF):</label>
              <input type="file" name="deliverable_file" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-2 text-xs text-slate-300 file:mr-3 file:py-1 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-purple-600 file:text-white">
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-300 mb-1">Mijozga eslatma yoki sharh:</label>
              <textarea name="submission_notes" rows="2" placeholder="Masalan: Barcha 15 ta slayd tayyor bo'ldi, ranglar brendingizga moslashtirildi." class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-2 text-xs text-slate-100 focus:outline-none focus:border-purple-500"></textarea>
            </div>

            <button type="submit" class="px-5 py-2.5 bg-purple-600 hover:bg-purple-500 text-white font-bold rounded-xl text-xs transition-all shadow-lg shadow-purple-600/30 flex items-center gap-2">
              <i class="fa-solid fa-paper-plane"></i> Ishni Mijozga Topshirish
            </button>
          </form>
        </div>
      <% } %>

      <!-- Action Box for Client (Review submitted work) -->
      <% if (isClient && order.status === 'submitted') { %>
        <div class="glass-box rounded-3xl p-6 border border-teal-500/40 bg-teal-500/10 space-y-4">
          <h3 class="text-base font-bold text-teal-300 flex items-center gap-2">
            <i class="fa-solid fa-gift"></i> Dizayner ishni topshirdi!
          </h3>
          <p class="text-xs text-slate-200">
            Iltimos, tayyorlangan ishni ko'rib chiqing. Agar ma'qul kelsa, tasdiqlang (shunda pul dizaynerga o'tadi). Agar kamchiligi bo'lsa, qayta ishlashga qaytarishingiz mumkin.
          </p>

          <div class="flex flex-wrap items-center gap-3 pt-2">
            <form action="/custom-orders/<%= order.id %>/approve" method="POST">
              <button type="submit" class="px-6 py-3 bg-emerald-600 hover:bg-emerald-500 text-white font-bold rounded-xl text-xs transition-all shadow-lg shadow-emerald-600/30 flex items-center gap-2">
                <i class="fa-solid fa-circle-check"></i> Ishni Qabul Qilish va Yakunlash
              </button>
            </form>

            <button type="button" onclick="document.getElementById('revisionBox').classList.toggle('hidden')" class="px-4 py-3 bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold rounded-xl text-xs transition-all flex items-center gap-2 border border-white/10">
              <i class="fa-solid fa-arrows-rotate"></i> Tuzatish so'rash
            </button>
          </div>

          <form id="revisionBox" action="/custom-orders/<%= order.id %>/revision" method="POST" class="hidden pt-4 space-y-3">
            <label class="block text-xs font-semibold text-slate-300">Qayerini o'zgartirish kerakligini aniq yozing:</label>
            <textarea name="revision_notes" required rows="3" placeholder="Masalan: 3-slayddagi matn hajmini kattalashtirish kerak..." class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-2 text-xs text-slate-100 focus:outline-none focus:border-purple-500"></textarea>
            <button type="submit" class="px-4 py-2 bg-amber-600 hover:bg-amber-500 text-white font-bold rounded-xl text-xs transition-all">
              Tuzatish so'rovini yuborish
            </button>
          </form>
        </div>
      <% } %>

      <!-- Topshirilgan Natijalar bloki (Agar bo'lsa) -->
      <% if (order.submission_file_url) { %>
        <div class="glass-box rounded-3xl p-6 border border-emerald-500/30 bg-[#0f172a]/90 space-y-3">
          <h3 class="text-sm font-bold text-white flex items-center gap-2">
            <i class="fa-solid fa-folder-open text-emerald-400"></i> Topshirilgan Natija
          </h3>
          <div class="flex items-center justify-between p-4 bg-slate-900/60 rounded-xl border border-white/5">
            <div class="truncate max-w-[70%]">
              <span class="text-xs text-slate-400 block mb-0.5">Topshirilgan havola / fayl:</span>
              <a href="<%= order.submission_file_url %>" target="_blank" class="text-sm font-bold text-indigo-400 hover:underline truncate block">
                <i class="fa-solid fa-arrow-up-right-from-square mr-1"></i> <%= order.submission_file_url %>
              </a>
            </div>
            <a href="<%= order.submission_file_url %>" target="_blank" download class="px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white font-bold rounded-xl text-xs transition-all">
              Ko'rish / Yuklab olish
            </a>
          </div>
          <% if (order.submission_notes) { %>
            <p class="text-xs text-slate-400 bg-slate-900/30 p-3 rounded-xl">
              <strong>Dizayner izohi:</strong> <%= order.submission_notes %>
            </p>
          <% } %>
        </div>
      <% } %>

      <!-- Brif va Talablar -->
      <div class="glass-box rounded-3xl p-6 border border-white/10 bg-[#0f172a]/90 space-y-4">
        <h3 class="text-base font-bold text-white flex items-center gap-2">
          <i class="fa-solid fa-file-lines text-indigo-400"></i> Texnik Topshiriq (Brif)
        </h3>

        <div class="space-y-2">
          <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block">Tavsif va matnlar:</span>
          <p class="text-sm text-slate-200 leading-relaxed bg-slate-900/60 p-4 rounded-2xl border border-white/5 whitespace-pre-line">
            <%= order.description %>
          </p>
        </div>

        <% if (order.reference_file_url) { %>
          <div class="pt-2">
            <span class="text-xs font-semibold text-slate-400 block mb-1">Ilova qilingan fayl / namuna:</span>
            <a href="<%= order.reference_file_url %>" target="_blank" class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-800 text-indigo-400 text-xs font-semibold hover:bg-slate-700 transition-colors">
              <i class="fa-solid fa-paperclip"></i> Namuna faylni ochish
            </a>
          </div>
        <% } %>
      </div>

    </div>

    <!-- Right Col: Financials and Participant Cards -->
    <div class="space-y-6">

      <!-- Moliyaviy Ma'lumotlar -->
      <div class="glass-box rounded-3xl p-6 border border-white/10 bg-[#0f172a]/90 space-y-4">
        <h3 class="text-sm font-bold text-white uppercase tracking-wider">Moliyaviy ma'lumotlar</h3>

        <div class="space-y-2.5 text-xs">
          <div class="flex items-center justify-between text-slate-400">
            <span>Xizmat turi:</span>
            <strong class="text-slate-200 capitalize"><%= order.service_type %></strong>
          </div>
          <div class="flex items-center justify-between text-slate-400">
            <span>Kutilayotgan format:</span>
            <strong class="text-slate-200"><%= order.format || 'Figma / SVG' %></strong>
          </div>
          <div class="flex items-center justify-between text-slate-400">
            <span>Muddat:</span>
            <strong class="text-slate-200"><%= order.deadline_days %> kun</strong>
          </div>
          <hr class="border-white/10 my-2">

          <div class="flex items-center justify-between text-slate-400">
            <span>Jami byudjet:</span>
            <strong class="text-emerald-400 text-base font-extrabold"><%= Number(order.budget).toLocaleString('uz-UZ') %> UZS</strong>
          </div>

          <% if (isDesigner || isAdmin) { %>
            <div class="flex items-center justify-between text-slate-400 pt-1">
              <span>Platforma komissiyasi (15%):</span>
              <span class="text-slate-500">-<%= Number(order.platform_fee).toLocaleString('uz-UZ') %> UZS</span>
            </div>
            <div class="flex items-center justify-between text-purple-300 font-bold bg-purple-500/10 p-2.5 rounded-xl border border-purple-500/20">
              <span>Dizayner sof daromadi (85%):</span>
              <span><%= Number(order.designer_share).toLocaleString('uz-UZ') %> UZS</span>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Ishtirokchilar -->
      <div class="glass-box rounded-3xl p-6 border border-white/10 bg-[#0f172a]/90 space-y-4">
        <h3 class="text-sm font-bold text-white uppercase tracking-wider">Ishtirokchilar</h3>

        <!-- Mijoz -->
        <div class="flex items-center gap-3 p-3 rounded-2xl bg-slate-900/60 border border-white/5">
          <img src="<%= order.client_avatar || 'https://raw.githubusercontent.com/lucide-icons/lucide/main/icons/user.svg' %>" class="w-10 h-10 rounded-xl object-cover bg-slate-800">
          <div class="truncate">
            <span class="text-[10px] uppercase font-bold text-slate-500 block">Buyurtmachi:</span>
            <span class="text-xs font-bold text-white block truncate"><%= order.client_name %></span>
            <span class="text-[11px] text-slate-400 truncate block"><%= order.client_email %></span>
          </div>
        </div>

        <!-- Dizayner -->
        <div class="flex items-center gap-3 p-3 rounded-2xl bg-slate-900/60 border border-white/5">
          <img src="<%= order.designer_avatar || 'https://raw.githubusercontent.com/lucide-icons/lucide/main/icons/user.svg' %>" class="w-10 h-10 rounded-xl object-cover bg-slate-800">
          <div class="truncate">
            <span class="text-[10px] uppercase font-bold text-purple-400 block">Ijrochi Dizayner:</span>
            <span class="text-xs font-bold text-white block truncate"><%= order.designer_name %></span>
            <span class="text-[11px] text-slate-400 truncate block"><%= order.designer_email %></span>
          </div>
        </div>
      </div>

    </div>

  </div>

</div>

<%- include('../partials/footer') %>
