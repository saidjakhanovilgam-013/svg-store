<%- include('../partials/header') %>

<div class="max-w-6xl mx-auto px-6 py-10">

  <!-- Header -->
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-8">
    <div>
      <h1 class="text-3xl font-extrabold text-white flex items-center gap-3">
        <i class="fa-solid fa-briefcase text-emerald-400"></i> Mening Buyurtmalarim
      </h1>
      <p class="text-xs text-slate-400 mt-1">Dizaynerlarga berilgan barcha shaxsiy dizayn va prezentatsiya buyurtmalari</p>
    </div>

    <a href="/shop" class="px-5 py-2.5 bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-semibold rounded-xl text-xs shadow-lg shadow-purple-500/20 transition-all flex items-center gap-2">
      <i class="fa-solid fa-compass"></i> Yangi dizayner topish
    </a>
  </div>

  <!-- Orders List -->
  <div class="glass-box rounded-3xl p-6 border border-white/10 bg-[#0f172a]/90">
    <% if (orders && orders.length > 0) { %>
      <div class="divide-y divide-white/5 space-y-4">
        <% orders.forEach(order => { %>
          <div class="pt-4 first:pt-0 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 hover:bg-slate-900/40 p-4 rounded-2xl transition-colors">

            <!-- Left Info -->
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-purple-500/20 text-purple-400 flex items-center justify-center text-xl flex-shrink-0 mt-1">
                <% if (order.service_type === 'presentation') { %>
                  <i class="fa-solid fa-file-powerpoint"></i>
                <% } else if (order.service_type === 'figma_uiux') { %>
                  <i class="fa-brands fa-figma"></i>
                <% } else { %>
                  <i class="fa-solid fa-paintbrush"></i>
                <% } %>
              </div>

              <div>
                <div class="flex items-center gap-2 flex-wrap mb-1">
                  <span class="text-xs font-bold text-slate-400">#<%= order.id %></span>
                  <h3 class="text-base font-bold text-white"><%= order.title %></h3>
                </div>

                <p class="text-xs text-slate-400 flex items-center gap-2 mb-2">
                  <span>Dizayner: <strong class="text-slate-200"><%= order.designer_name %></strong></span>
                  <span>•</span>
                  <span>Muddat: <strong class="text-slate-300"><%= order.deadline_days %> kun</strong></span>
                  <span>•</span>
                  <span><%= new Date(order.created_at).toLocaleDateString('uz-UZ') %></span>
                </p>

                <!-- Status Badge -->
                <div>
                  <% if (order.status === 'pending') { %>
                    <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-amber-500/10 text-amber-300 border border-amber-500/30">
                      <i class="fa-solid fa-clock mr-1"></i> Dizayner ko'rib chiqmoqda
                    </span>
                  <% } else if (order.status === 'accepted' && !order.is_paid) { %>
                    <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-indigo-500/10 text-indigo-300 border border-indigo-500/30">
                      <i class="fa-solid fa-check mr-1"></i> Qabul qilindi (To'lov kutilmoqda)
                    </span>
                  <% } else if (order.status === 'in_progress') { %>
                    <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-purple-500/10 text-purple-300 border border-purple-500/30 animate-pulse">
                      <i class="fa-solid fa-gear mr-1"></i> Ish jarayonida
                    </span>
                  <% } else if (order.status === 'submitted') { %>
                    <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-teal-500/10 text-teal-300 border border-teal-500/30">
                      <i class="fa-solid fa-gift mr-1"></i> Ish topshirildi (Tekshirish kerak)
                    </span>
                  <% } else if (order.status === 'completed') { %>
                    <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-500/10 text-emerald-300 border border-emerald-500/30">
                      <i class="fa-solid fa-circle-check mr-1"></i> Yakunlangan
                    </span>
                  <% } else if (order.status === 'rejected') { %>
                    <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-rose-500/10 text-rose-300 border border-rose-500/30">
                      <i class="fa-solid fa-xmark mr-1"></i> Rad etildi
                    </span>
                  <% } %>
                </div>
              </div>
            </div>

            <!-- Right Info & Actions -->
            <div class="flex items-center gap-4 self-end md:self-center">
              <div class="text-right">
                <span class="block text-xs text-slate-400">Byudjet:</span>
                <span class="text-base font-extrabold text-emerald-400"><%= Number(order.budget).toLocaleString('uz-UZ') %> UZS</span>
              </div>

              <a href="/custom-orders/detail/<%= order.id %>" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-white font-semibold rounded-xl text-xs transition-all flex items-center gap-1.5 border border-white/5">
                Batafsil <i class="fa-solid fa-chevron-right text-[10px]"></i>
              </a>
            </div>

          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="text-center py-16">
        <div class="w-16 h-16 rounded-full bg-slate-800/80 text-slate-500 flex items-center justify-center mx-auto mb-4 text-2xl">
          <i class="fa-solid fa-briefcase"></i>
        </div>
        <h3 class="text-lg font-bold text-white mb-1">Sizda hali buyurtmalar yo'q</h3>
        <p class="text-xs text-slate-400 mb-6">Dizaynerlarimizga prezentatsiya, Figma yoki illyustratsiya buyurtma bering.</p>
        <a href="/shop" class="px-6 py-3 bg-purple-600 hover:bg-purple-500 text-white font-bold rounded-xl text-xs transition-all shadow-lg shadow-purple-600/30 inline-flex items-center gap-2">
          <i class="fa-solid fa-compass"></i> Do'kon va Dizaynerlar
        </a>
      </div>
    <% } %>
  </div>

</div>

<%- include('../partials/footer') %>
