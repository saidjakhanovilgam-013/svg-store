<%- include('../partials/header') %>

<div class="max-w-7xl mx-auto px-6 py-10">
  
  <!-- Sarlavha va Navigatsiya -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
    <div>
      <h1 class="text-3xl font-extrabold text-white flex items-center gap-3">
        <i class="fa-solid fa-user-shield text-amber-400"></i> Admin Boshqaruv Paneli
      </h1>
      <p class="text-slate-400 text-sm mt-1">Platforma statistikasi, arizalar va moderatsiya</p>
    </div>
    
    <a href="/admin/requests" class="px-5 py-2.5 bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-bold rounded-xl text-sm shadow-lg shadow-purple-500/20 transition-all flex items-center gap-2">
      <i class="fa-solid fa-id-card"></i> Dizaynerlik Arizalari
    </a>
  </div>

  <!-- Stat Kartochkalar -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-10">
    
    <div class="glass-box rounded-2xl p-5 border border-white/10 relative overflow-hidden">
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Jami Foydalanuvchilar</span>
        <div class="w-10 h-10 rounded-xl bg-indigo-500/20 text-indigo-400 flex items-center justify-center text-lg">
          <i class="fa-solid fa-users"></i>
        </div>
      </div>
      <div class="text-3xl font-black text-white"><%= stats.usersCount || 0 %></div>
    </div>

    <div class="glass-box rounded-2xl p-5 border border-white/10 relative overflow-hidden">
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Dizaynerlar</span>
        <div class="w-10 h-10 rounded-xl bg-purple-500/20 text-purple-400 flex items-center justify-center text-lg">
          <i class="fa-solid fa-pen-nib"></i>
        </div>
      </div>
      <div class="text-3xl font-black text-purple-400"><%= stats.designersCount || 0 %></div>
    </div>

    <div class="glass-box rounded-2xl p-5 border border-white/10 relative overflow-hidden">
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Jami SVG Fayllar</span>
        <div class="w-10 h-10 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-lg">
          <i class="fa-solid fa-layer-group"></i>
        </div>
      </div>
      <div class="text-3xl font-black text-emerald-400"><%= stats.productsCount || 0 %></div>
    </div>

    <div class="glass-box rounded-2xl p-5 border border-white/10 relative overflow-hidden">
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Platforma Tushumi</span>
        <div class="w-10 h-10 rounded-xl bg-amber-500/20 text-amber-400 flex items-center justify-center text-lg">
          <i class="fa-solid fa-sack-dollar"></i>
        </div>
      </div>
      <div class="text-2xl font-black text-amber-400">
        <%= Number(stats.totalRevenue || 0).toLocaleString('uz-UZ') %> UZS
      </div>
    </div>

  </div>

  <!-- Moderatsiyadagi SVG Fayllar -->
  <div class="glass-box rounded-3xl p-6 border border-white/10">
    <h3 class="text-lg font-bold text-white mb-6 flex items-center gap-2">
      <i class="fa-solid fa-clock-rotate-left text-amber-400"></i> Moderatsiyadagi SVG Fayllar
    </h3>

    <% if (pendingProducts && pendingProducts.length > 0) { %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <% pendingProducts.forEach(prod => { %>
          <div class="p-4 bg-slate-900/60 rounded-2xl border border-white/5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 bg-slate-800 rounded-xl p-2 flex items-center justify-center">
                <img src="<%= prod.preview_svg_path %>" alt="<%= prod.title %>" class="max-h-full max-w-full filter invert">
              </div>
              <div>
                <h4 class="font-bold text-white text-sm"><%= prod.title %></h4>
                <span class="text-xs text-emerald-400 font-bold"><%= Number(prod.price).toLocaleString('uz-UZ') %> UZS</span>
              </div>
            </div>
            <div class="flex items-center gap-2 self-end sm:self-auto">
              <form action="/admin/product/<%= prod.id %>/approve" method="POST">
                <button type="submit" title="Tasdiqlash" aria-label="Tasdiqlash" class="w-9 h-9 rounded-lg bg-emerald-500/20 hover:bg-emerald-500 text-emerald-400 hover:text-white flex items-center justify-center transition-all">
                  <i class="fa-solid fa-check"></i>
                </button>
              </form>
              <form action="/admin/product/<%= prod.id %>/reject" method="POST">
                <button type="submit" title="Rad etish" aria-label="Rad etish" class="w-9 h-9 rounded-lg bg-rose-500/20 hover:bg-rose-500 text-rose-400 hover:text-white flex items-center justify-center transition-all">
                  <i class="fa-solid fa-xmark"></i>
                </button>
              </form>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="text-center py-12 text-slate-400">
        <i class="fa-solid fa-circle-check text-4xl text-emerald-500/50 block mb-3"></i>
        Moderatsiya kutilayotgan yangi fayllar yo'q.
      </div>
    <% } %>
  </div>

</div>

<%- include('../partials/footer') %>
