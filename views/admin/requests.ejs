<%- include('../partials/header') %>

<div class="max-w-6xl mx-auto px-6 py-10">
  
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-2xl font-extrabold text-white flex items-center gap-3">
        <i class="fa-solid fa-id-card text-purple-400"></i> Dizaynerlik Arizalari
      </h1>
      <p class="text-slate-400 text-xs mt-1">Sotuvchi bo'lish uchun kelib tushgan so'rovlar</p>
    </div>
    
    <a href="/admin/dashboard" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold rounded-xl text-xs transition-all flex items-center gap-2">
      <i class="fa-solid fa-arrow-left"></i> Panelga qaytish
    </a>
  </div>

  <div class="glass-box rounded-3xl p-6 border border-white/10">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm text-slate-300">
        <thead class="text-xs text-slate-400 uppercase bg-slate-900/60 rounded-xl">
          <tr>
            <th class="p-4">Foydalanuvchi</th>
            <th class="p-4">Email</th>
            <th class="p-4">Sana</th>
            <th class="p-4 text-right">Amal</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-white/5">
          <% if (requests && requests.length > 0) { %>
            <% requests.forEach(req => { %>
              <tr class="hover:bg-slate-900/40 transition-colors">
                <td class="p-4 font-bold text-white"><%= req.user_name || req.name %></td>
                <td class="p-4 text-slate-400"><%= req.user_email || req.email %></td>
                <td class="p-4 text-xs text-slate-400"><%= new Date(req.created_at).toLocaleDateString('uz-UZ') %></td>
                <td class="p-4 text-right">
                  <form action="/admin/request/<%= req.id %>/approve" method="POST" class="inline-block">
                    <button type="submit" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs rounded-xl shadow-lg shadow-emerald-600/20 transition-all flex items-center gap-1.5">
                      <i class="fa-solid fa-user-check"></i> Dizayner qilish
                    </button>
                  </form>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="4" class="text-center py-10 text-slate-400">
                Ayni paytda yangi arizalar yo'q.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

</div>

<%- include('../partials/footer') %>
